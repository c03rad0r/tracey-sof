{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracey-sof:purchases:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purchases"],
  "properties": {
    "schema_version": {"const": 1},
    "purchases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/purchase"}}
  },
  "$defs": {
    "txid": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outpoint": {"type": "object", "additionalProperties": false, "required": ["txid", "vout"], "properties": {"txid": {"$ref": "#/$defs/txid"}, "vout": {"type": "integer", "minimum": 0, "maximum": 4294967295}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "description": {"type": "string"}}},
    "purchase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "date": {"type": "string", "format": "date-time"},
        "provider": {"type": "string"},
        "txids": {"type": "array", "items": {"$ref": "#/$defs/txid"}, "uniqueItems": true},
        "addresses": {"type": "array", "items": {"type": "string", "minLength": 14}, "uniqueItems": true},
        "outpoints": {"type": "array", "items": {"$ref": "#/$defs/outpoint"}},
        "amount_sats": {"type": "integer", "minimum": 1},
        "fiat": {"type": "object", "additionalProperties": false, "required": ["amount", "currency"], "properties": {"amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "notes": {"type": "string"}
      }
    }
  }
}
