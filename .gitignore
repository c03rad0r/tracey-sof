# Private user information and generated artifacts. The default location is
# outside this repository ($HOME/tracey-inputs); these entries are a second line
# of defence against accidental in-repo copies.
/data/
/out/
/cache/
/tracey-inputs/
/tmp/

# Local build, dependency, and test state
/.cache/
/.tools/
/bin/
/coverage/

# Local credentials
.env
node.env
*.cookie

# Optional Ansible inventory with host-specific connection details
/ansible/inventory.ini
*.retry

# Local builder-key fingerprint notes; public keys belong in a .gpg directory
/trusted-keys
/trusted-keys~

# Editors and operating systems
.DS_Store
*.swp

# Dependency downloads must never add credentials or user exports
*.prof
*.cover
*.out
