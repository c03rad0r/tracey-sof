# Example local node settings. Copy to node.env; node.env is ignored by git.
# Do not put RPC passwords in tracked files. Core's cookie authentication is preferred.
BITCOIND_RPC_URL=http://127.0.0.1:8332
BITCOIND_COOKIE_FILE=/change/me/.bitcoin/.cookie
DATA_DIR=./data
OUT_DIR=./out
CACHE_DIR=./cache
# These legacy limits apply only when data/trace-policy.json is absent.
TRACE_MAX_DEPTH=25
TRACE_MAX_TRANSACTIONS=10000
